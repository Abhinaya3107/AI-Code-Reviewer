# Copy to .env and fill in. Real values go ONLY in .env, which is never committed.
# This file is a public template: keep every secret below blank.

PORT=3001

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
# The .pem contents on ONE line, with a literal \n for each line break
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Redis (local, or a hosted one such as Upstash: use the rediss:// URL)
REDIS_URL=redis://localhost:6379

# LLM: "fake" works offline for testing; "gemini" needs LLM_API_KEY
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=

# Optional: without it the worker still reviews PRs but stores nothing.
# Any PostgreSQL URL, e.g. from Neon. Create the tables once with:  uv run alembic upgrade head
DATABASE_URL=
