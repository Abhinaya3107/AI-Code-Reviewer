// PostgreSQL schema. Diffs and source code are deliberately NOT stored: only review results.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  queued
  running
  completed
  failed
  skipped
}

model Installation {
  id                   Int          @id @default(autoincrement())
  githubInstallationId BigInt       @unique
  accountLogin         String
  createdAt            DateTime     @default(now())
  repositories         Repository[]
  usageEvents          UsageEvent[]
}

model Repository {
  id             Int           @id @default(autoincrement())
  installationId Int
  installation   Installation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  githubRepoId   BigInt        @unique
  fullName       String
  /// Dashboard toggle. When false the worker skips reviews for this repository.
  enabled        Boolean       @default(true)
  configJson     Json?
  createdAt      DateTime      @default(now())
  pullRequests   PullRequest[]

  @@index([installationId])
}

model PullRequest {
  id           Int        @id @default(autoincrement())
  repositoryId Int
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  author       String
  state        String     @default("open")
  reviews      Review[]

  @@unique([repositoryId, number])
}

model Review {
  id            Int             @id @default(autoincrement())
  pullRequestId Int
  pullRequest   PullRequest     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  headSha       String
  status        ReviewStatus    @default(queued)
  summary       String?
  overallRisk   String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Decimal?        @db.Decimal(12, 6)
  durationMs    Int?
  filesReviewed Int?
  skipReason    String?
  errorMessage  String?
  attempts      Int             @default(0)
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  comments      ReviewComment[]
  usageEvents   UsageEvent[]

  /// One review per commit: makes retries and redeliveries idempotent.
  @@unique([pullRequestId, headSha])
  @@index([pullRequestId, createdAt])
}

model ReviewComment {
  id              Int     @id @default(autoincrement())
  reviewId        Int
  review          Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  path            String
  line            Int
  severity        String
  category        String
  message         String
  suggestedFix    String?
  githubCommentId BigInt?
  /// Hash of (path, message): identifies the same finding across commits.
  fingerprint     String
  /// +1 / -1 from the dashboard, null until rated.
  feedback        Int?

  @@index([reviewId])
}

model UsageEvent {
  id             Int          @id @default(autoincrement())
  installationId Int
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  reviewId       Int?
  review         Review?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  /// "YYYY-MM", for monthly usage caps and analytics.
  month          String
  tokens         Int
  costUsd        Decimal?     @db.Decimal(12, 6)
  createdAt      DateTime     @default(now())

  @@index([installationId, month])
}
